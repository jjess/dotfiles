! Dracula Xresources palette
*.foreground: #F8F8F2
*.background: #282A36
*.color0:     #000000
*.color8:     #4D4D4D
*.color1:     #FF5555
*.color9:     #FF6E67
*.color2:     #50FA7B
*.color10:    #5AF78E
*.color3:     #F1FA8C
*.color11:    #F4F99D
*.color4:     #BD93F9
*.color12:    #CAA9FA
*.color5:     #FF79C6
*.color13:    #FF92D0
*.color6:     #8BE9FD
*.color14:    #9AEDFE
*.color7:     #BFBFBF
*.color15:    #E6E6E6


XTerm.vt100.bellIsUrgent : false
!bell禁止
XTerm.vt100.saveLines: 4096

XTerm.vt100.fastScroll: true

XTerm.vt100.alternateScroll: true

XTerm.vt100.jumpScroll: true

XTerm*utf8Title: true

XTerm*toolBar: false

XTerm*faceName: JetBrainsMono Nerd Font Mono
XTerm*faceSize: 10

XTerm*utf8: 2
XTerm*utf8Fonts: always
XTerm*locale: true

XTerm*pointerShape: left_ptr
XTerm*pointerMode: 1

! prueba OSC52
XTerm*disallowedWindowOps: 20,21,SetXprop
